# Copy to .env (gitignored) and fill in. bin/load-secret.sh can generate the SASL lines
# from the AmazonMSK_env-sensor_karafka secret in Secrets Manager.

KAFKA_SASL_USERNAME=karafka
KAFKA_SASL_PASSWORD=__from_secrets_manager__

# ローカルからは踏み台 SSH ポートフォワード + /etc/hosts で b-1..b-3 を 127.0.0.2..4 に解決する。
KAFKA_BOOTSTRAP=b-1.envsensorkafka.2ci9mq.c4.kafka.ap-northeast-1.amazonaws.com:9096,b-2.envsensorkafka.2ci9mq.c4.kafka.ap-northeast-1.amazonaws.com:9096,b-3.envsensorkafka.2ci9mq.c4.kafka.ap-northeast-1.amazonaws.com:9096

KAFKA_SSL_CA_LOCATION=/etc/ssl/cert.pem
